    .header .btn-export:hover {
      background: #059669;
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(16, 185, 129, 0.25);
    }

    .header .btn-export i {
      font-size: 16px;
    }

    /* Contenedor principal */
    .container {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
