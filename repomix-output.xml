        procesados++;
        await new Promise(resolve => setTimeout(resolve, 50));
      }

      progreso.update(100, '¡Proceso completado!',
        `📊 RESUMEN FINAL:\n` +
        `✅ Procesados: ${procesados}\n` +
        `🆕 Nuevos episodios: ${nuevos}\n` +
