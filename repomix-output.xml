      border-radius: 16px;
      padding: 12px 16px;
      font-size: 12px;
      font-family: 'Monaco', 'Menlo', monospace;
      color: #1e293b;
      margin-top: 8px;
    }

    .progress-details p {
      margin: 4px 0;
      padding: 2px 0;
      border-bottom: 1px solid #e9edf4;
    }

    .progress-details .success-text { color: #10b981; }
    .progress-details .error-text { color: #dc2626; }
    .progress-details .info-text { color: #f6821f; }

