    .service-picker.source { border-color: #0078D4; background: #e1f0ff; }
    .service-picker.destination { border-color: #10b981; background: #e6f7e6; }

    .service-picker label {
      display: block;
      font-weight: 700;
      font-size: 13px;
      color: #475569;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .service-picker select {
      width: 100%;
      padding: 12px 16px;
      border: 2px solid #e2e8f0;
      border-radius: 14px;
      font-size: 15px;
      font-weight: 600;
      font-family: inherit;
      background: white;
      color: #0b2b5c;
      cursor: pointer;
      transition: all 0.2s;
    }

    .service-picker select:focus {
