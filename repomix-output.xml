<body>
  <div class="container">
    <h1><i class="fas fa-download"></i> Editar Series de Descarga</h1>

    <!-- Serie -->
    <div class="form-group">
      <label><i class="fas fa-tv"></i> Nombre de la Serie</label>
      <select id="serieSelect">
        <option value="" disabled selected>Seleccionar...</option>
      </select>
    </div>

    <!-- Temporada -->
    <div class="form-group">
      <label><i class="fas fa-layer-group"></i> Temporada</label>
      <select id="temporadaSelect">
        <option value="" disabled selected>Seleccionar...</option>
      </select>
      <div class="inline-actions">
        <button onclick="nuevaEntrada('temporada')"><i class="fas fa-plus"></i> Nueva Temporada</button>
      </div>
      <div id="nuevaTemporadaInput" class="hidden-input-group">
        <input type="text" id="nuevaTemporada" placeholder="Ej: Temporada 02" />
        <div class="btn-group">
          <button onclick="guardarNuevaEntrada('temporada')">Guardar</button>
          <button onclick="cancelarEntrada('temporada')">Cancelar</button>
        </div>
      </div>
    </div>

    <!-- Idioma -->
    <div class="form-group">
      <label><i class="fas fa-language"></i> Idioma</label>
      <select id="idiomaSelect">
        <option value="" disabled selected>Seleccionar...</option>
      </select>
      <div class="inline-actions">
        <button onclick="nuevaEntrada('idioma')"><i class="fas fa-plus"></i> Nuevo Idioma</button>
      </div>
      <div id="nuevoIdiomaInput" class="hidden-input-group">
        <input type="text" id="nuevoIdioma" placeholder="Ej: Español" />
        <div class="btn-group">
          <button onclick="guardarNuevaEntrada('idioma')">Guardar</button>
          <button onclick="cancelarEntrada('idioma')">Cancelar</button>
        </div>
      </div>
    </div>

    <!-- Servidor -->
    <div class="form-group">
      <label><i class="fas fa-server"></i> Servidor</label>
      <select id="servidorSelect">
        <option value="" disabled selected>Seleccionar...</option>
      </select>
      <div class="inline-actions">
        <button onclick="nuevaEntrada('servidor')"><i class="fas fa-plus"></i> Nuevo Servidor</button>
      </div>
      <div id="nuevoServidorInput" class="hidden-input-group">
        <input type="text" id="nuevoServidor" placeholder="Ej: Servidor 01" />
        <div class="btn-group">
          <button onclick="guardarNuevaEntrada('servidor')">Guardar</button>
          <button onclick="cancelarEntrada('servidor')">Cancelar</button>
        </div>
      </div>
    </div>

    <!-- Episodios -->
    <h2><i class="fas fa-list-ul"></i> Episodios y Enlaces de Descarga</h2>
    <div class="episodios-header">
      <div class="btn-group">
        <button onclick="document.getElementById('importarTxt').click()"><i class="fas fa-file-alt"></i> Importar TXT</button>
        <button class="btn-excel" onclick="document.getElementById('importarExcel').click()"><i class="fas fa-file-excel"></i> Importar Excel</button>
        <input type="file" id="importarTxt" accept=".txt" style="display:none;" />
        <input type="file" id="importarExcel" accept=".xlsx, .xls" style="display:none;" />
      </div>
    </div>

    <div class="table-wrapper">
      <table id="tabla-episodios">
        <thead>
          <tr>
            <th>Episodio</th>
            <th>Enlaces de Descarga Directa</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="tablaBody"></tbody>
      </table>
    </div>

    <button class="btn-agregar" onclick="agregarFila()"><i class="fas fa-plus-circle"></i> Agregar Fila</button>

    <!-- Acciones finales -->
    <div class="acciones-finales">
      <button class="btn-cloudflare" onclick="location.href='../Interfaces-Cloudflare/Editar-Serie-Descarga.html'">
        <i class="fas fa-cloud"></i> Cloudflare
      </button>
      <button class="btn-sql-server" onclick="location.href='../Interfaces-Azure/Editar-Serie-Descarga.html'">
        <i class="fas fa-server"></i> SQL Server
      </button>
      <button onclick="guardarCambios()"><i class="fas fa-save"></i> Actualizar</button>
    </div>
  </div>

  <!-- Firebase SDK -->
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"></script>
  <script type="module" src="../../Config/config.js"></script>
<script defer src="../../Controllers/js_firebase/Editar_SerieDescarga_Controller.js"></script>
  
</body>
</html>
</file>

