      color: #0078D4;
      text-align: center;
      font-size: 14px;
    }

    /* ============ ESTADÍSTICAS ============ */
    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 16px;
      margin-top: 8px;
    }

    .stat-box {
      background: #f8fafc;
      padding: 16px;
      border-radius: 16px;
