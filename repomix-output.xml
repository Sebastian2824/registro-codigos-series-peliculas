      align-items: center;
      justify-content: center;
      font-size: 32px;
      color: #1a73e8;
      border: 1px solid #d3e3fd;
      transition: transform 0.2s;
    }

    .transfer-illustration .icon-block .icon-box:hover {
      transform: scale(1.05);
    }

    .transfer-illustration .icon-block .label {
      font-size: 13px;
      font-weight: 500;
      color: #475569;
    }

    .transfer-illustration .icon-block .label-code {
      font-size: 12px;
