          dominioActualInput.value = 'Error';
          infoDominio.innerHTML = '<i class="fas fa-times-circle" style="color:#dc2626;"></i> Error al detectar';
        }
      } else {
        dominioContainer.classList.remove('visible');
      }
    }

    // ========== ACTUALIZAR DOMINIOS (SERIE ACTUAL) ==========
    async function actualizarDominiosSerie() {
      const nuevoDominio = document.getElementById('nuevoDominio').value.trim();
      const dominioActual = document.getElementById('dominioActual').value.trim();
      
      if (!nuevoDominio) {
        alert('Por favor, ingresa un nuevo dominio válido');
        return;
      }
      if (nuevoDominio === dominioActual) {
        alert('El nuevo dominio es igual al actual. No se realizarán cambios.');
        return;
      }

      const res = await fetch(`${WORKER_URL}/episodios?serie=${encodeURIComponent(serieActual)}&temporada=${encodeURIComponent(temporadaActual)}&idioma=${encodeURIComponent(idiomaActual)}&servidor=${encodeURIComponent(servidorActual)}`);
      const episodios = await res.json();
      
      if (episodios.length === 0) {
        alert('No hay episodios para actualizar');
        return;
      }

      if (!confirm(`¿Actualizar ${episodios.length} episodios?\nSerie: ${serieActual}\nDominio actual: ${dominioActual}\nNuevo dominio: ${nuevoDominio}`)) return;

      const progreso = mostrarProgreso('Actualizando Serie', episodios.length);
      let actualizados = 0, errores = 0;

      for (let i = 0; i < episodios.length; i++) {
        const ep = episodios[i];
        const nuevoIframe = ep.iframe.replace(new RegExp(`https?://${dominioActual.replace(/\./g, '\\.')}`, 'g'), `https://${nuevoDominio}`);
        if (nuevoIframe !== ep.iframe) {
          try {
            const updateRes = await fetch(`${WORKER_URL}/actualizar-episodio`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                serie: serieActual,
                temporada: temporadaActual,
                idioma: idiomaActual,
                servidor: servidorActual,
                episodio: ep.episodio,
                iframe: nuevoIframe
              })
            });
            if (updateRes.ok) {
              actualizados++;
              progreso.update(
                ((i + 1) / episodios.length) * 100,
                `Procesando: ${i + 1} de ${episodios.length}`,
                `✅ ${ep.episodio} - Actualizado`
              );
            } else {
              errores++;
              progreso.update(
                ((i + 1) / episodios.length) * 100,
                `Procesando: ${i + 1} de ${episodios.length}`,
                `❌ ${ep.episodio} - Error`
              );
            }
          } catch (error) {
            errores++;
            progreso.update(
              ((i + 1) / episodios.length) * 100,
              `Procesando: ${i + 1} de ${episodios.length}`,
              `❌ ${ep.episodio} - ${error.message}`
            );
          }
        } else {
          progreso.update(
            ((i + 1) / episodios.length) * 100,
            `Procesando: ${i + 1} de ${episodios.length}`,
            `⏭️ ${ep.episodio} - Sin cambios`
          );
        }
        await new Promise(resolve => setTimeout(resolve, 100));
      }

      progreso.update(100, '¡Proceso completado!', `📊 Resumen: ${actualizados} actualizados, ${errores} errores`);
      await new Promise(resolve => setTimeout(resolve, 2000));
      progreso.cerrar();
      alert(`✅ Proceso completado:\n- Episodios actualizados: ${actualizados}\n- Errores: ${errores}`);
      await cargarEpisodios();
      await actualizarMarcoDominio();
    }

    // ========== ACTUALIZAR DOMINIOS (TODAS LAS SERIES) ==========
    async function actualizarDominiosTodasSeries() {
      const nuevoDominio = document.getElementById('nuevoDominio').value.trim();
      const dominioActual = document.getElementById('dominioActual').value.trim();
      
      if (!nuevoDominio) {
        alert('Por favor, ingresa un nuevo dominio válido');
        return;
      }
      if (nuevoDominio === dominioActual) {
        alert('El nuevo dominio es igual al actual. No se realizarán cambios.');
        return;
      }

      if (!confirm(`⚠️ ADVERTENCIA: Esto actualizará TODOS los episodios de TODAS las series con servidor que contenga "abyss"\n\nDominio actual: ${dominioActual}\nNuevo dominio: ${nuevoDominio}\n\n¿Estás completamente seguro?`)) return;

      const seriesRes = await fetch(`${WORKER_URL}/nombres-series`);
      const series = await seriesRes.json();
      
      const progreso = mostrarProgreso('Analizando estructura', series.length);
      const episodiosPorActualizar = [];
      
      for (let i = 0; i < series.length; i++) {
        const serie = series[i];
        progreso.update(
          ((i + 1) / series.length) * 100,
          `Analizando serie: ${serie}`,
          `🔍 Buscando servidores "abyss" en ${serie}`
        );
        try {
          const tempsRes = await fetch(`${WORKER_URL}/temporadas?serie=${encodeURIComponent(serie)}`);
          const temporadas = await tempsRes.json();
          for (const temp of temporadas) {
            const idiomasRes = await fetch(`${WORKER_URL}/idiomas?serie=${encodeURIComponent(serie)}&temporada=${encodeURIComponent(temp)}`);
            const idiomas = await idiomasRes.json();
            for (const idioma of idiomas) {
              const servidoresRes = await fetch(`${WORKER_URL}/servidores?serie=${encodeURIComponent(serie)}&temporada=${encodeURIComponent(temp)}&idioma=${encodeURIComponent(idioma)}`);
              const servidores = await servidoresRes.json();
              for (const servidor of servidores) {
                if (servidor.toLowerCase().includes('abyss')) {
                  const episodiosRes = await fetch(`${WORKER_URL}/episodios?serie=${encodeURIComponent(serie)}&temporada=${encodeURIComponent(temp)}&idioma=${encodeURIComponent(idioma)}&servidor=${encodeURIComponent(servidor)}`);
                  const episodios = await episodiosRes.json();
                  for (const ep of episodios) {
                    const nuevoIframe = ep.iframe.replace(new RegExp(`https?://${dominioActual.replace(/\./g, '\\.')}`, 'g'), `https://${nuevoDominio}`);
                    if (nuevoIframe !== ep.iframe) {
                      episodiosPorActualizar.push({
                        serie, temp, idioma, servidor,
                        episodio: ep.episodio,
                        nuevoIframe
                      });
                    }
                  }
                }
              }
            }
          }
        } catch (error) {
          console.error(`Error analizando serie ${serie}:`, error);
        }
      }
      progreso.cerrar();

      if (episodiosPorActualizar.length === 0) {
        alert('No se encontraron episodios para actualizar');
        return;
      }
      if (!confirm(`Se encontraron ${episodiosPorActualizar.length} episodios para actualizar. ¿Deseas continuar?`)) return;

      const progresoActualizacion = mostrarProgreso('Actualizando Todas las Series', episodiosPorActualizar.length);
      let actualizados = 0, errores = 0;

      for (let i = 0; i < episodiosPorActualizar.length; i++) {
        const item = episodiosPorActualizar[i];
        try {
          const updateRes = await fetch(`${WORKER_URL}/actualizar-episodio`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              serie: item.serie,
              temporada: item.temp,
              idioma: item.idioma,
              servidor: item.servidor,
              episodio: item.episodio,
              iframe: item.nuevoIframe
            })
          });
          if (updateRes.ok) {
            actualizados++;
            progresoActualizacion.update(
              ((i + 1) / episodiosPorActualizar.length) * 100,
              `Procesando: ${i + 1} de ${episodiosPorActualizar.length}`,
              `✅ ${item.serie} > ${item.episodio}`
            );
          } else {
            errores++;
            progresoActualizacion.update(
              ((i + 1) / episodiosPorActualizar.length) * 100,
              `Procesando: ${i + 1} de ${episodiosPorActualizar.length}`,
              `❌ ${item.serie} > ${item.episodio}`
            );
          }
        } catch (error) {
          errores++;
          progresoActualizacion.update(
            ((i + 1) / episodiosPorActualizar.length) * 100,
            `Procesando: ${i + 1} de ${episodiosPorActualizar.length}`,
            `❌ ${item.serie} > ${item.episodio} - ${error.message}`
          );
        }
        await new Promise(resolve => setTimeout(resolve, 100));
      }

      progresoActualizacion.update(100, '¡Proceso completado!', `📊 Resumen: ${actualizados} actualizados, ${errores} errores`);
      await new Promise(resolve => setTimeout(resolve, 2000));
      progresoActualizacion.cerrar();
      alert(`✅ Proceso completado:\n- Episodios actualizados: ${actualizados}\n- Errores: ${errores}`);
      if (serieActual && temporadaActual && idiomaActual && servidorActual) {
        await cargarEpisodios();
        await actualizarMarcoDominio();
      }
    }

    // ========== CARGAR DATOS ==========
