    @media (max-width: 768px) {
      body { padding: 16px; }
      .header { flex-direction: column; align-items: flex-start; padding: 16px 20px; }
      .header h2 { font-size: 22px; }
      .filtros-container { flex-direction: column; align-items: stretch; padding: 16px; }
      .filtros-container .form-group { flex: 1 1 auto; }
      .filtros-container .btn-group { flex-wrap: wrap; }
      .filtros-container .btn-group .btn { flex: 1; justify-content: center; }
    }

    @media (max-width: 480px) {
      table { font-size: 13px; }
      th, td { padding: 8px 10px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Encabezado -->
    <div class="header">
      <h2><i class="fas fa-crown"></i> Series Originales</h2>
      <span class="badge"><i class="fas fa-database"></i> Azure SQL Database</span>
    </div>

    <!-- Navegación entre interfaces -->
    <div class="service-selector">
      <span class="service-label"><i class="fas fa-exchange-alt"></i> Exportar con:</span>
      <a href="../Interfaces-Firebase/Exportar-Serie-Original.html" class="service-btn">
        <span class="dot firebase"></span>
        <i class="fas fa-fire"></i> Firebase
      </a>
      <a href="../Interfaces-Cloudflare/Exportar-Serie-Original.html" class="service-btn">
        <span class="dot cloudflare"></span>
        <i class="fas fa-cloud"></i> Cloudflare
      </a>
      <button class="service-btn active">
        <span class="dot sqlserver"></span>
        <i class="fas fa-database"></i> SQL Server
      </button>
    </div>

    <!-- Filtros -->
    <div class="filtros-container">
      <div class="form-group">
        <label><i class="fas fa-tv"></i> Serie</label>
        <select id="filtroSerie"><option value="">Todas las series</option></select>
      </div>
      <div class="form-group">
        <label><i class="fas fa-layer-group"></i> Temporada</label>
        <select id="filtroTemporada"><option value="">Todas las temporadas</option></select>
      </div>
      <div class="form-group">
        <label><i class="fas fa-language"></i> Idioma</label>
        <select id="filtroIdioma"><option value="">Todos los idiomas</option></select>
      </div>
      <div class="form-group">
        <label><i class="fas fa-server"></i> Servidor</label>
        <select id="filtroServidor"><option value="">Todos los servidores</option></select>
      </div>
      <div class="btn-group">
        <button class="btn btn-primary" onclick="aplicarFiltros()"><i class="fas fa-filter"></i> Aplicar</button>
        <button class="btn btn-outline" onclick="resetearFiltros()"><i class="fas fa-undo"></i> Resetear</button>
        <button class="btn btn-success" onclick="exportarTablaAExcel()"><i class="fas fa-file-excel"></i> Exportar Excel</button>
        <button class="btn btn-secondary" onclick="copiarTodosURLs()"><i class="fas fa-copy"></i> Copiar Todos</button>
      </div>
    </div>

    <!-- Tabla -->
    <div class="table-container">
      <table id="tablaSeries">
        <thead>
          <tr>
            <th>Serie</th>
            <th>Temporada</th>
            <th>Idioma</th>
            <th>Servidor</th>
            <th>Episodio</th>
            <th style="max-width: 300px;">Enlace URL</th>
            <th>Copiar</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>

    <!-- Paginación -->
    <div id="paginacion"></div>

  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script type="module" src="../../Config/config.js"></script>
<script defer src="../../Controllers/js_azure/Exportar_SerieOriginal_Controller.js"></script>
</body>
</html>
</file>

