      .panel { padding: 24px 20px; }
      .panel .icon-large { width: 64px; height: 64px; font-size: 32px; }
      .transfer-illustration { gap: 12px; }
      .transfer-illustration .icon-block .icon-box { width: 60px; height: 60px; font-size: 26px; }
      .transfer-illustration .arrow { font-size: 24px; }
    }
  </style>
</head>
