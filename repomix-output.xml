            <i class="fas fa-cloud"></i> SQL Server
          </button>
          <button class="btn btn-primary" id="btnGuardar"><i class="fas fa-save"></i> Guardar en Cloudflare</button>
        </div>
      </div>
    </div>

  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script type="module" src="../../Config/config.js"></script>
<script defer src="../../Controllers/js_cloudflare/Registro_NuevaSerie_Controller.js"></script>

