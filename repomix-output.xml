      font-size: 12px;
      color: #1e293b;
    }

    .log-info div {
      padding: 4px 0;
      border-bottom: 1px solid #e9edf4;
    }

    .log-info strong { color: #0078D4; }
    .log-info hr { border: none; border-top: 1px solid #e9edf4; margin: 6px 0; }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 900px) {
      .transfer-selector {
        grid-template-columns: 1fr;
      }
      .arrow-container i {
        transform: rotate(90deg);
      }
      @keyframes pulse {
        0%, 100% { opacity: 1; transform: rotate(90deg) scale(1); }
        50% { opacity: 0.6; transform: rotate(90deg) scale(1.1); }
      }
    }

    @media (max-width: 768px) {
