function escapeHTML(str) {
    if (!str) return '';
    return str.replace(/&/g, '&amp;')
              .replace(/</g, '&lt;')
              .replace(/>/g, '&gt;')
              .replace(/"/g, '&quot;')
              .replace(/'/g, '&#039;');
}

function mostrarProgreso(titulo, totalItems) {
    const overlay = document.createElement('div');
    overlay.className = 'progress-overlay';
    overlay.id = 'progressOverlay';
