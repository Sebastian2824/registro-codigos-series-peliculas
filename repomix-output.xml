<body>
  <div class="container">

    <!-- Header -->
    <header class="header">
      <h2><i class="fas fa-exchange-alt"></i> Transferencia Multiservicio</h2>
      <span class="badge"><i class="fas fa-database"></i> Firebase · Cloudflare · SQL Server</span>
    </header>

    <!-- Configuración -->
    <div class="card">
      <h3><i class="fas fa-sliders-h"></i> Configuración de Transferencia</h3>

      <div class="transfer-selector">
        <!-- Origen -->
        <div class="service-picker source">
          <label><i class="fas fa-sign-out-alt"></i> Origen (de dónde leer)</label>
          <select id="selectSource">
            <option value="firebase">🔥 Firebase</option>
            <option value="cloudflare">☁️ Cloudflare</option>
            <option value="sqlserver">🗄️ SQL Server</option>
          </select>
          <div class="current-info">
            <i class="fas fa-info-circle"></i>
            <span id="sourceInfo">Lee datos desde Firestore</span>
          </div>
        </div>

        <!-- Flecha -->
        <div class="arrow-container">
          <i class="fas fa-arrow-right"></i>
        </div>

        <!-- Destino -->
        <div class="service-picker destination">
          <label><i class="fas fa-sign-in-alt"></i> Destino (a dónde escribir)</label>
          <select id="selectDestination">
            <option value="cloudflare">☁️ Cloudflare</option>
            <option value="sqlserver">🗄️ SQL Server</option>
            <option value="firebase">🔥 Firebase</option>
          </select>
          <div class="current-info">
            <i class="fas fa-info-circle"></i>
            <span id="destinationInfo">Escribe en Cloudflare Worker</span>
          </div>
        </div>
      </div>

      <div class="controls">
        <button class="btn btn-primary" id="btnCargar"><i class="fas fa-download"></i> Cargar Datos del Origen</button>
        <button class="btn btn-success" id="btnTransferir" disabled><i class="fas fa-cloud-upload-alt"></i> Transferir al Destino</button>
        <button class="btn btn-danger" id="btnLimpiar"><i class="fas fa-trash-alt"></i> Limpiar Tabla</button>
      </div>

      <!-- Barra de progreso de carga -->
      <div id="loadingProgress" class="progress-container" style="display: none;">
        <div class="progress-bar-wrapper">
          <div id="loadingProgressBar" class="progress-bar">0%</div>
        </div>
        <div id="loadingProgressText" class="progress-text">Cargando...</div>
      </div>

      <!-- Filtros -->
      <div class="filter-section">
        <div class="form-group">
          <label><i class="fas fa-tv"></i> Serie</label>
          <input type="text" id="filterSerie" placeholder="Nombre de la serie">
        </div>
        <div class="form-group">
          <label><i class="fas fa-layer-group"></i> Temporada</label>
          <input type="text" id="filterTemporada" placeholder="Nombre de temporada">
        </div>
        <div class="form-group">
          <label><i class="fas fa-language"></i> Idioma</label>
          <input type="text" id="filterIdioma" placeholder="Idioma">
        </div>
        <div class="form-group" style="align-self: flex-end;">
          <div style="display: flex; gap: 8px;">
            <button class="btn btn-outline" id="btnAplicarFiltro"><i class="fas fa-filter"></i> Aplicar</button>
            <button class="btn btn-outline" id="btnLimpiarFiltro"><i class="fas fa-undo"></i> Limpiar</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabla de datos -->
    <div class="card">
      <h3><i class="fas fa-list-ul"></i> Datos Cargados</h3>
      <div class="table-container" id="tablaDatosContainer">
        <div id="tablaDatos">
          <p style="text-align: center; padding: 40px; color: #94a3b8;">
            <i class="fas fa-info-circle" style="font-size: 24px; display: block; margin-bottom: 8px;"></i>
            Selecciona origen y destino, luego haz clic en "Cargar Datos del Origen"
          </p>
        </div>
      </div>

      <div id="pagination" class="pagination" style="display: none;">
        <button id="btnFirstPage">Primera</button>
        <button id="btnPrevPage">Anterior</button>
        <span id="paginationInfo" class="pagination-info">Página 1 de 1</span>
        <button id="btnNextPage">Siguiente</button>
        <button id="btnLastPage">Última</button>
      </div>
    </div>

    <!-- Progreso de transferencia -->
    <div id="transferProgress" class="progress-container" style="display: none;">
      <div class="progress-bar-wrapper">
        <div id="transferProgressBar" class="progress-bar">0%</div>
      </div>
      <div id="transferProgressText" class="progress-text">Transfiriendo...</div>
    </div>

    <!-- Estadísticas -->
    <div class="card">
      <h3><i class="fas fa-chart-bar"></i> Estadísticas</h3>
      <div class="stats">
        <div class="stat-box">
          <h4>Series</h4>
          <div class="stat-value" id="statSeries">0</div>
        </div>
        <div class="stat-box">
          <h4>Temporadas</h4>
          <div class="stat-value" id="statTemporadas">0</div>
        </div>
        <div class="stat-box">
          <h4>Episodios</h4>
          <div class="stat-value" id="statEpisodios">0</div>
        </div>
        <div class="stat-box">
          <h4>Servidores únicos</h4>
          <div class="stat-value" id="statServidores">0</div>
        </div>
      </div>
    </div>

    <!-- Log -->
    <div class="card">
      <h3><i class="fas fa-bug"></i> Log de Operaciones</h3>
      <button class="btn btn-outline" id="btnToggleLog"><i class="fas fa-eye"></i> Mostrar/Ocultar</button>
      <div id="logInfo" class="log-info" style="display: none;">
        <div id="logContent"></div>
      </div>
    </div>

  </div>

  <!-- Firebase SDK -->
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"></script>
  <script type="module" src="../../Controllers/js_multi_servidor/Transferencia de Servicios_ContenidoSerie.js"></script>
</body>
</html>
