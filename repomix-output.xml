          <button class="btn btn-firebase" onclick="location.href='../Interfaces-Firebase/Registro-Nueva-Serie.html'">
            <i class="fas fa-fire"></i> Firebase
          </button>
          <button class="btn btn-cloudflare" onclick="location.href='../Interfaces-Cloudflare/Registro-Nueva-Serie.html'">
            <i class="fas fa-cloud"></i> Cloudflare
          </button>
          <button class="btn btn-primary" id="btnGuardar"><i class="fas fa-save"></i> Guardar en SQL Server</button>
        </div>
      </div>
    </div>

  </div>

