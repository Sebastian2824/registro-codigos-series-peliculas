      max-width: 300px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* ============ PAGINACIÓN ============ */
    .pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      margin-top: 16px;
      flex-wrap: wrap;
    }

    .pagination button {
      padding: 6px 16px;
      border: 1px solid #e2e8f0;
      border-radius: 30px;
      background: white;
      font-family: inherit;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      transition: all 0.2s;
      color: #1e293b;
    }

    .pagination button:hover:not(:disabled) {
      background: #f1f5f9;
      border-color: #94a3b8;
      transform: translateY(-2px);
    }

    .pagination button:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }

    .pagination-info { font-weight: 600; color: #0b2b5c; padding: 0 12px; }

    /* ============ PROGRESO ============ */
    .progress-container {
      margin: 16px 0 8px;
      background: #f8fafc;
      border-radius: 16px;
      padding: 16px 20px;
      border: 1px solid #e9edf4;
    }

    .progress-bar-wrapper {
      width: 100%;
      height: 24px;
      background: #e9edf4;
      border-radius: 60px;
      overflow: hidden;
    }

    .progress-bar {
      height: 100%;
      width: 0;
      background: linear-gradient(90deg, #0078D4, #10b981);
      border-radius: 60px;
      transition: width 0.4s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 700;
      font-size: 13px;
    }

    .progress-text {
      margin-top: 8px;
      font-weight: 600;
      color: #0078D4;
      text-align: center;
      font-size: 14px;
    }

    /* ============ ESTADÍSTICAS ============ */
    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 16px;
      margin-top: 8px;
    }

    .stat-box {
      background: #f8fafc;
      padding: 16px;
      border-radius: 16px;
      text-align: center;
      border: 1px solid #e9edf4;
    }

    .stat-box h4 { font-size: 14px; font-weight: 600; color: #475569; margin-bottom: 4px; }
    .stat-box .stat-value { font-size: 28px; font-weight: 700; color: #0078D4; }

    /* ============ LOG ============ */
    .log-info {
      background: #f8fafc;
      border: 1px solid #e9edf4;
