    .episodios-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px;
      margin-bottom: 20px;
    }

    .episodios-header .btn-group {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .episodios-header button {
      padding: 8px 20px;
      border-radius: 40px;
      border: none;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
