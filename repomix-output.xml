      border: 1px solid #e9edf4;
      background: white;
      margin-top: 8px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 15px;
    }

    th {
      background: #f1f5f9;
      color: #0b2b5c;
      font-weight: 700;
      padding: 14px 18px;
      text-align: left;
      border-bottom: 2px solid #e2e8f0;
      text-transform: uppercase;
      font-size: 13px;
      letter-spacing: 0.3px;
    }

    td {
      padding: 10px 16px;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: middle;
    }

    tr:hover td {
      background: #fafcff;
    }

    td input[type="text"] {
      border-radius: 12px;
      padding: 8px 12px;
      border: 1px solid #e2e8f0;
      background: white;
      font-size: 14px;
      width: 100%;
      min-width: 120px;
    }

    td input[type="text"]:focus {
      border-color: #f6821f;
    }

    td .acciones {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    td .acciones button {
      padding: 6px 14px;
      border-radius: 30px;
      border: none;
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s;
      font-family: inherit;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    td .acciones .btn-actualizar {
      background: #f6821f;
      color: white;
    }

    td .acciones .btn-actualizar:hover {
      background: #d96f1a;
    }

    td .acciones .btn-registrar {
      background: #10b981;
      color: white;
    }

    td .acciones .btn-registrar:hover {
      background: #059669;
    }

    td .acciones .btn-eliminar,
    td .acciones .btn-eliminar-fila {
      background: #f1f5f9;
      color: #dc2626;
    }

    td .acciones .btn-eliminar:hover,
    td .acciones .btn-eliminar-fila:hover {
      background: #fee2e2;
    }

    .btn-agregar {
      margin-top: 18px;
      padding: 10px 24px;
      border-radius: 40px;
      background: #10b981;
      color: white;
      border: none;
      font-weight: 600;
      font-size: 15px;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: inherit;
    }

    .btn-agregar:hover {
