}

// ========== PAGINACIÓN ==========

function renderizarPaginacion() {
  const contenedor = document.getElementById("paginacion");
  contenedor.innerHTML = "";

  const totalPaginas = Math.ceil(datosFiltrados.length / registrosPorPagina);
  if (totalPaginas <= 1) return;

