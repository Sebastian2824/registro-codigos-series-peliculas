      background: #1a73e8;
    }

    .acciones-finales .btn-firebase:hover {
      background: #1557b0;
      box-shadow: 0 6px 20px rgba(26, 115, 232, 0.25);
    }

    .acciones-finales .btn-sql-server {
      background: #1a73e8;
    }

    .acciones-finales .btn-sql-server:hover {
      background: #1557b0;
      box-shadow: 0 6px 20px rgba(26, 115, 232, 0.25);
    }

    .acciones-finales .btn-guardar {
      background: #10b981;
    }

    .acciones-finales .btn-guardar:hover {
      background: #059669;
      box-shadow: 0 6px 20px rgba(16, 185, 129, 0.25);
