    /* ============ CARD ============ */
    .card {
      background: #ffffff;
      border-radius: 24px;
      padding: 24px 28px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
      border: 1px solid #e9edf4;
      margin-bottom: 24px;
    }

    .card h3 {
      font-size: 18px;
      font-weight: 700;
      color: #0b2b5c;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 2px solid #e9edf4;
      padding-bottom: 10px;
    }

    .card h3 i { color: #0078D4; }

    /* ============ SELECTOR ============ */
    .transfer-selector {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 20px;
      align-items: center;
      margin-bottom: 20px;
    }

    .service-picker {
