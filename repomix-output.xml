    }

    .log-info div { padding: 4px 0; border-bottom: 1px solid #e9edf4; }
    .log-info strong { color: #0078D4; }
    .log-info hr { border: none; border-top: 1px solid #e9edf4; margin: 6px 0; }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 900px) {
      .transfer-selector { grid-template-columns: 1fr; }
      .arrow-container i { transform: rotate(90deg); }
      @keyframes pulse {
        0%, 100% { opacity: 1; transform: rotate(90deg) scale(1); }
        50% { opacity: 0.6; transform: rotate(90deg) scale(1.1); }
      }
    }

    @media (max-width: 768px) {
      body { padding: 16px; }
      .header { flex-direction: column; align-items: flex-start; padding: 16px 20px; }
      .header h2 { font-size: 22px; }
      .card { padding: 18px; }
      .controls { flex-direction: column; align-items: stretch; }
      .btn { justify-content: center; }
      .filter-section { flex-direction: column; align-items: stretch; }
      .stats { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 480px) {
      table { font-size: 13px; }
      th, td { padding: 6px 10px; }
      .stats { grid-template-columns: 1fr; }
      .url-cell { max-width: 120px; }
    }
  </style>
