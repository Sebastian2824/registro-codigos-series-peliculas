    .pagination button:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }

    .pagination-info { font-weight: 600; color: #0b2b5c; padding: 0 12px; }

    /* ============ PROGRESO ============ */
    .progress-container {
      margin: 16px 0 8px;
      background: #f8fafc;
      border-radius: 16px;
      padding: 16px 20px;
      border: 1px solid #e9edf4;
    }

    .progress-bar-wrapper {
      width: 100%;
      height: 24px;
      background: #e9edf4;
      border-radius: 60px;
      overflow: hidden;
    }

    .progress-bar {
      height: 100%;
      width: 0;
      background: linear-gradient(90deg, #0078D4, #10b981);
      border-radius: 60px;
      transition: width 0.4s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 700;
      font-size: 13px;
