  <!-- Encabezado -->
  <header class="header">
    <div class="logo">
      <i class="fas fa-cloud-upload-alt"></i>
      <h1>Transferencia de Series - Portadas</h1>
    </div>
    <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
      <span class="badge"><i class="fas fa-fire"></i> Firebase</span>
      <button class="btn-export" onclick="location.href='Exportar-Portadas-Registradas.html'">
        <i class="fas fa-file-export"></i> Exportar Datos
      </button>
    </div>
  </header>

  <!-- Contenido principal -->
  <main class="container">
    <div class="panel">
      <div class="icon-large">
        <i class="fas fa-sync-alt"></i>
      </div>
      <h2>De Colección a Colección</h2>
      <p class="subtitle">
        Antes de exportar, transfiere solo las series que aún no se encuentran transferidas en la colección <code>animes-series-portadas-resumen</code>.
      </p>

      <!-- Ilustración -->
      <div class="transfer-illustration">
        <div class="icon-block">
          <div class="icon-box">📂</div>
          <span class="label">Colección</span>
          <span class="label-code">animes-series-portadas</span>
        </div>
        <div class="arrow">
          <i class="fas fa-arrow-right"></i>
        </div>
        <div class="icon-block">
          <div class="icon-box">📂</div>
          <span class="label">Colección</span>
          <span class="label-code">animes-series-portadas-resumen</span>
        </div>
      </div>

      <!-- Botón -->
      <button class="btn-transfer" id="btnGenerarResumenPortadas">
        <i class="fas fa-play"></i> Iniciar Transferencia
      </button>

      <!-- Estado -->
      <div id="estado">
        <i class="fas fa-info-circle"></i> Listo para transferir
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="footer">
    &copy; 2025 <span>Transferencia de Datos</span> · Sistema Firebase
  </footer>

  <!-- Firebase SDKs -->
  <script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-firestore-compat.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script type="module" src="../../Controllers/js_firebase/Transferencia_PortadasRegistradas_Controller.js"></script>
  
</body>
</html>
