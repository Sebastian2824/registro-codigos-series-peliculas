    @keyframes pulse-arrow {
      0%, 100% { transform: translateX(0); opacity: 0.6; }
      50% { transform: translateX(8px); opacity: 1; }
    }

    /* Botón de acción */
    .btn-transfer {
      padding: 14px 32px;
      border: none;
      border-radius: 40px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.25s ease;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: inherit;
      background: linear-gradient(135deg, #1a73e8, #1557b0);
      color: white;
      box-shadow: 0 6px 20px rgba(26, 115, 232, 0.2);
    }

    .btn-transfer:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 28px rgba(26, 115, 232, 0.3);
    }

    .btn-transfer:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    .btn-transfer i {
      font-size: 18px;
    }

    /* Estado */
    #estado {
      margin-top: 24px;
      padding: 14px 20px;
      border-radius: 16px;
      font-size: 14px;
      font-weight: 500;
      background: #f8fafc;
      color: #475569;
      border: 1px solid #e9edf4;
      min-height: 60px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.3s;
    }

    #estado.success {
      background: #e6f7e6;
      color: #0a5e0a;
      border-color: #34a853;
    }

    #estado.error {
      background: #fde8e8;
      color: #991b1b;
      border-color: #dc2626;
    }

    #estado.info {
      background: #e8f0fe;
      color: #1a4b8c;
      border-color: #1a73e8;
    }

    #estado .spinner {
      display: inline-block;
      width: 18px;
      height: 18px;
      border: 2px solid #cbd5e1;
      border-top-color: #1a73e8;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Footer */
    .footer {
      text-align: center;
      padding: 18px 20px;
      font-size: 14px;
      color: #94a3b8;
      border-top: 1px solid #e9edf4;
      background: #ffffff;
    }

    .footer span {
      color: #1a73e8;
      font-weight: 600;
    }

