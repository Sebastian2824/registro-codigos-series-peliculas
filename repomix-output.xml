      display: none;
      margin-top: 10px;
      padding: 14px;
      background: #ffffff;
      border-radius: 16px;
      border: 1px solid #e2e8f0;
    }

    .hidden-input-group input {
      border-radius: 12px;
    }

    .hidden-input-group .btn-group {
      display: flex;
      gap: 10px;
      margin-top: 10px;
    }

    .hidden-input-group .btn-group button {
      padding: 6px 16px;
      border-radius: 30px;
      background: #e9edf4;
      border: none;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      font-family: inherit;
    }

    .hidden-input-group .btn-group button:first-child {
      background: #f6821f;
      color: white;
    }

    .hidden-input-group .btn-group button:first-child:hover {
      background: #d96f1a;
    }

    .hidden-input-group .btn-group button:last-child {
      background: #e9edf4;
      color: #1e293b;
    }

    .hidden-input-group .btn-group button:last-child:hover {
      background: #d1d9e6;
    }

