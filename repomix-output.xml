}

// ============================================================
// RESETEO
// ============================================================
function resetearFiltros() {
    document.getElementById('filtroSerie').value = '';
    document.getElementById('filtroTemporada').value = '';
    document.getElementById('filtroIdioma').value = '';
    document.getElementById('filtroServidor').value = '';
