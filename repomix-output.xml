      color: #1e293b;
      white-space: nowrap;
    }

    .btn:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08); }

    .btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }

    .btn-primary { background: #0078D4; color: white; }
    .btn-primary:hover:not(:disabled) { background: #005a9e; box-shadow: 0 6px 16px rgba(0, 120, 212, 0.25); }

    .btn-success { background: #10b981; color: white; }
    .btn-success:hover:not(:disabled) { background: #059669; box-shadow: 0 6px 16px rgba(16, 185, 129, 0.25); }

    .btn-danger { background: #dc2626; color: white; }
    .btn-danger:hover:not(:disabled) { background: #b91c1c; box-shadow: 0 6px 16px rgba(220, 38, 38, 0.25); }

    .btn-outline { background: transparent; color: #1e293b; border: 1px solid #e2e8f0; }
    .btn-outline:hover:not(:disabled) { background: #f1f5f9; border-color: #cbd5e1; }

    /* ============ FILTROS ============ */
    .filter-section {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      align-items: flex-end;
      margin-top: 16px;
    }

    .filter-section .form-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .filter-section .form-group label {
      font-weight: 600;
      font-size: 13px;
      color: #0b2b5c;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .filter-section .form-group label i { color: #0078D4; width: 16px; text-align: center; }

    .filter-section .form-group input {
      padding: 8px 14px;
      border: 2px solid #e2e8f0;
      border-radius: 14px;
      font-size: 14px;
      font-family: inherit;
      background: white;
      transition: all 0.2s;
      min-width: 160px;
    }

    .filter-section .form-group input:focus {
      border-color: #0078D4;
      outline: none;
      box-shadow: 0 0 0 4px rgba(0, 120, 212, 0.08);
    }

    /* ============ TABLA ============ */
    .table-container {
      overflow-x: auto;
      border-radius: 16px;
      border: 1px solid #e9edf4;
      max-height: 480px;
      overflow-y: auto;
      margin-top: 12px;
    }

    .table-container::-webkit-scrollbar { width: 6px; height: 6px; }
    .table-container::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

    table { width: 100%; border-collapse: collapse; font-size: 14px; }

    th {
      background: #f1f5f9;
      color: #0b2b5c;
      font-weight: 700;
      padding: 12px 16px;
      text-align: left;
      border-bottom: 2px solid #e2e8f0;
      text-transform: uppercase;
      font-size: 12px;
      letter-spacing: 0.3px;
      position: sticky;
      top: 0;
      z-index: 5;
      white-space: nowrap;
    }

    td {
      padding: 10px 16px;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: middle;
      word-break: break-word;
    }

    tr:hover td { background: #fafcff; }

    .url-cell {
      font-family: 'Monaco', 'Menlo', monospace;
      font-size: 13px;
