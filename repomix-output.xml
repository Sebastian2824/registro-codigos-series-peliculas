      background: transparent;
      border: 1px solid #e2e8f0;
      border-radius: 30px;
      padding: 4px 12px;
      font-size: 14px;
      cursor: pointer;
      transition: all 0.2s;
      color: #1e293b;
      font-family: inherit;
    }

    .btn-copy:hover {
      background: #e9edf4;
      border-color: #94a3b8;
      transform: scale(1.05);
    }

    /* ============ PAGINACIÓN ============ */
    #paginacion {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 14px;
      margin-top: 16px;
      flex-wrap: wrap;
    }

    #paginacion button {
      padding: 8px 18px;
      border: 1px solid #e2e8f0;
      border-radius: 40px;
      background: white;
      font-family: inherit;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      transition: all 0.2s;
      color: #1e293b;
    }

    #paginacion button:hover:not(:disabled) {
      background: #f1f5f9;
      border-color: #94a3b8;
      transform: translateY(-2px);
    }

    #paginacion button:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }

    #paginacion span { font-weight: 600; color: #0b2b5c; padding: 0 8px; }

    .empty-message {
      text-align: center;
      padding: 40px 20px;
      color: #94a3b8;
      font-size: 15px;
    }

    .empty-message i {
      font-size: 40px;
      display: block;
      margin-bottom: 12px;
      color: #cbd5e1;
    }

