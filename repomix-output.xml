    .btn:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08); }

    .btn-primary { background: #0078D4; color: white; }
    .btn-primary:hover { background: #005a9e; box-shadow: 0 6px 16px rgba(0, 120, 212, 0.25); }

    .btn-success { background: #10b981; color: white; }
    .btn-success:hover { background: #059669; box-shadow: 0 6px 16px rgba(16, 185, 129, 0.25); }

    .btn-outline { background: transparent; color: #1e293b; border: 1px solid #e2e8f0; }
    .btn-outline:hover { background: #f1f5f9; border-color: #cbd5e1; }

    .btn-warning { background: #0078D4; color: white; }
    .btn-warning:hover { background: #005a9e; box-shadow: 0 6px 16px rgba(0, 120, 212, 0.25); }

    /* ============ FORMULARIO DE DIMENSIONES ============ */
    .dimension-form {
      display: none;
      background: #e1f0ff;
      border-radius: 20px;
      padding: 24px 28px;
      margin-top: 20px;
      border: 1px solid #b8daff;
    }

    .dimension-form.visible {
      display: block;
      animation: fadeSlide 0.3s ease;
    }

    @keyframes fadeSlide {
      0% { opacity: 0; transform: translateY(10px); }
      100% { opacity: 1; transform: translateY(0); }
    }

    .dimension-form .form-row {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: flex-end;
    }

    .dimension-form .form-row .field { flex: 1 1 180px; min-width: 140px; }

    .dimension-form .form-row .field label {
      display: block;
      font-weight: 600;
      font-size: 14px;
      color: #0b2b5c;
      margin-bottom: 4px;
    }

    .dimension-form .form-row .field input {
      width: 100%;
      padding: 10px 14px;
      border: 2px solid #e2e8f0;
      border-radius: 14px;
      font-size: 14px;
      font-family: inherit;
      background: white;
      transition: all 0.2s;
    }

    .dimension-form .form-row .field input:focus {
      border-color: #0078D4;
      outline: none;
      box-shadow: 0 0 0 4px rgba(0, 120, 212, 0.08);
    }

    .dimension-form .form-row .field input::placeholder { color: #94a3b8; }

    .dimension-form .form-actions {
      display: flex;
      gap: 12px;
      margin-top: 16px;
      flex-wrap: wrap;
    }

    /* ============ ACCIONES FINALES ============ */
    .acciones-finales {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 12px;
      margin-top: 24px;
    }

    /* ============ MENSAJE VACÍO ============ */
    .empty-message {
      text-align: center;
      padding: 40px 20px;
      color: #94a3b8;
      font-size: 15px;
    }

    .empty-message i {
      font-size: 40px;
      display: block;
      margin-bottom: 12px;
      color: #cbd5e1;
    }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 768px) {
      body { padding: 16px; }
      .header { flex-direction: column; align-items: flex-start; padding: 16px 20px; }
      .header h1 { font-size: 22px; }
      .filtros-container { flex-direction: column; align-items: stretch; padding: 16px; }
      .filtros-container .form-group { flex: 1 1 auto; }
      .dimension-form .form-row { flex-direction: column; }
      .dimension-form .form-row .field { flex: 1 1 auto; width: 100%; }
      .btn-group .btn { flex: 1; justify-content: center; }
      .acciones-finales { flex-direction: column; }
      .acciones-finales .btn { width: 100%; justify-content: center; }
    }

    @media (max-width: 480px) {
      table { font-size: 13px; }
      th, td { padding: 8px 10px; }
      td textarea { font-size: 12px; min-height: 50px; }
    }
  </style>
</head>
