      border: 1px solid #e9edf4;
      text-align: center;
    }

    .panel .icon-large {
      font-size: 48px;
      color: #1a73e8;
      background: #eef4ff;
      width: 80px;
      height: 80px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
    }

    .panel h2 {
      font-size: 24px;
      font-weight: 700;
      color: #0b2b5c;
      margin-bottom: 8px;
    }

    .panel .subtitle {
      font-size: 15px;
      color: #64748b;
      margin-bottom: 24px;
