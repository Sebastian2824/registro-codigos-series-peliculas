<body>

  <div class="container">

    <!-- Encabezado -->
    <header class="header">
      <h2><i class="fas fa-crown"></i> Importar Series Originales</h2>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <span class="badge"><i class="fas fa-fire"></i> Firebase</span>
      </div>
    </header>

    <!-- Navegación entre interfaces -->
    <div class="service-selector">
      <span class="service-label"><i class="fas fa-exchange-alt"></i> Importar con:</span>
      <a href="../Interfaces-Cloudflare/Registro&Editar-Excel-Serie-Original.html" class="service-btn">
        <span class="dot cloudflare"></span>
        <i class="fas fa-cloud"></i> Cloudflare
      </a>
      <a href="../Interfaces-Azure/Registro&Editar-Excel-Serie-Original.html" class="service-btn">
        <span class="dot sqlserver"></span>
        <i class="fas fa-server"></i> SQL Server
      </a>
      <button class="service-btn active">
        <span class="dot firebase"></span>
        <i class="fas fa-fire"></i> Firebase
      </button>
    </div>

    <!-- Subida de archivo -->
    <div class="card">
      <h3><i class="fas fa-upload"></i> Cargar archivo Excel</h3>
      <div class="upload-area" id="uploadArea">
        <i class="fas fa-cloud-upload-alt"></i>
        <p>Selecciona un archivo <strong>.xlsx</strong></p>
        <span class="sub">Arrastra o haz clic para seleccionar</span>
        <input type="file" id="inputExcel" accept=".xlsx">
      </div>

      <div class="actions">
        <button class="btn btn-success" id="saveButton" disabled>
          <i class="fas fa-save"></i> Guardar en Firebase
        </button>
      </div>
    </div>

    <!-- Previsualización -->
    <div class="card">
      <h3><i class="fas fa-table"></i> Previsualización de datos</h3>
      <div class="table-container">
        <div id="panelPreview">
          <div class="empty-message">
            <i class="fas fa-file-excel"></i>
            Carga un archivo Excel para ver los datos
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Firebase SDK -->
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script type="module" src="../../Config/config.js"></script>
<script defer src="../../Controllers/js_firebase/Registro&Editar_Excel_SerieOriginal.js"></script>

</body>
</html>
