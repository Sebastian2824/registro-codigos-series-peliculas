    <!-- Episodios -->
    <div class="form-card">
      <div class="episodios-header">
        <h3><i class="fas fa-list-ul"></i> Episodios y Códigos de Incrustación</h3>
        <div class="btn-group">
          <button onclick="document.getElementById('importarTxt').click()"><i class="fas fa-file-alt"></i> Importar TXT</button>
          <button class="btn-excel" onclick="document.getElementById('importarExcel').click()"><i class="fas fa-file-excel"></i> Importar Excel</button>
          <input type="file" id="importarTxt" accept=".txt" style="display: none;">
          <input type="file" id="importarExcel" accept=".xlsx, .xls" style="display: none;">
        </div>
      </div>

      <div class="table-container">
        <table id="tablaEpisodios">
          <thead>
            <tr>
              <th>Episodio</th>
              <th>Código de incrustación</th>
              <th style="width: 120px;">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><input type="text" placeholder="Ej: Episodio 1"></td>
              <td><input type="text" placeholder="&lt;iframe&gt;...&lt;/iframe&gt;"></td>
              <td><button class="btn-eliminar" onclick="eliminarFila(this)"><i class="fas fa-trash-alt"></i> Eliminar</button></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="action-buttons">
        <div class="left-group">
          <button class="btn btn-success" id="btnAgregarFila"><i class="fas fa-plus-circle"></i> Agregar fila</button>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
          <button class="btn btn-cloudflare" onclick="location.href='../Interfaces-Cloudflare/Registro-Nueva-Serie.html'">
            <i class="fas fa-cloud"></i> Cloudflare
          </button>
          <button class="btn btn-sql-server" onclick="location.href='../Interfaces-Azure/Registro-Nueva-Serie.html'">
            <i class="fas fa-cloud"></i> SQL Server
          </button>
          <button class="btn btn-primary" id="btnGuardar"><i class="fas fa-save"></i> Guardar en Firebase</button>
        </div>
      </div>
    </div>

  </div>

  <!-- Firebase SDK -->
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script type="module" src="../../Config/config.js"></script>
<script defer src="../../Controllers/js_firebase/Registro_NuevaSerie_Controller.js"></script>

</body>
</html>
