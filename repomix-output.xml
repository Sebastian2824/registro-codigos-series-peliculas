});

btnCargar.addEventListener('click', async function () {
    const origen = selectSource.value;

    btnCargar.disabled = true;
    btnCargar.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Cargando...';
    loadingProgress.style.display = 'block';
