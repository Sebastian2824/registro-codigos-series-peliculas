    }

    /* ============ PROGRESO ============ */
    .progress-overlay {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: rgba(15, 23, 42, 0.7);
      backdrop-filter: blur(6px);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 1000;
    }

    .progress-container {
      background: white;
      border-radius: 32px;
      padding: 36px 40px;
      max-width: 480px;
      width: 90%;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.3);
      animation: slideUp 0.4s ease;
    }

    @keyframes slideUp {
      0% { opacity: 0; transform: translateY(40px); }
      100% { opacity: 1; transform: translateY(0); }
    }

    .progress-title {
      font-size: 20px;
      font-weight: 700;
      color: #0b2b5c;
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 18px;
    }

    .progress-info {
      background: #f8fafc;
      padding: 12px 16px;
      border-radius: 16px;
      margin-bottom: 16px;
      font-size: 14px;
    }

    .progress-info p { margin: 4px 0; }

    .progress-bar-wrapper {
      background: #e9edf4;
      border-radius: 60px;
      overflow: hidden;
      height: 28px;
      margin: 16px 0;
    }

    .progress-bar {
      width: 0%;
      height: 100%;
      background: linear-gradient(90deg, #0078D4, #10b981, #1a73e8);
      transition: width 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 700;
      font-size: 14px;
      border-radius: 60px;
    }

    .progress-status {
      text-align: center;
      font-size: 14px;
      color: #475569;
      margin: 8px 0 12px;
    }

    .progress-details {
      max-height: 160px;
      overflow-y: auto;
      background: #f8fafc;
      border-radius: 16px;
      padding: 12px 16px;
      font-size: 12px;
      font-family: monospace;
      color: #1e293b;
      margin-top: 8px;
    }

    .progress-details p {
      margin: 4px 0;
      padding: 2px 0;
      border-bottom: 1px solid #e9edf4;
    }

    .progress-details .success-text { color: #10b981; }
    .progress-details .error-text { color: #dc2626; }

    @media (max-width: 768px) {
      body { padding: 16px; }
      .container { padding: 24px 18px; }
      h1 { font-size: 24px; }
      h2 { font-size: 20px; }
      .dominio-container { padding: 20px; }
      .acciones-finales { justify-content: center; }
      .acciones-finales button { flex: 1; justify-content: center; }
      .acciones-finales .label-ir { flex: 1 1 100%; justify-content: center; margin-right: 0; margin-bottom: 8px; }
    }

    @media (max-width: 480px) {
      .container { padding: 18px 14px; }
      .form-group { padding: 16px; }
      .inline-actions { flex-direction: column; align-items: stretch; }
      .episodios-header .btn-group { flex-direction: column; }
      .acciones-finales button { width: 100%; }
    }
  </style>
</head>
