  <div class="container">

    <!-- Encabezado -->
    <div class="header">
      <h1><i class="fas fa-expand-alt"></i> Redimensionar Iframes</h1>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <span class="badge"><i class="fas fa-fire"></i> Firebase</span>
      </div>
    </div>

    <!-- Navegación entre interfaces -->
    <div class="service-selector">
      <span class="service-label"><i class="fas fa-exchange-alt"></i> Redimensionar con:</span>
      <a href="../Interfaces-Azure/Redimensionar-Iframes-Registrados.html" class="service-btn">
        <span class="dot sqlserver"></span>
        <i class="fas fa-server"></i> SQL Server
      </a>
      <a href="../Interfaces-Cloudflare/Redimensionar-Iframes-Registrados.html" class="service-btn">
        <span class="dot cloudflare"></span>
        <i class="fas fa-cloud"></i> Cloudflare
      </a>
      <button class="service-btn active">
        <span class="dot firebase"></span>
        <i class="fas fa-fire"></i> Firebase
      </button>
    </div>

    <!-- Selectores -->
    <div class="filtros-container">
      <div class="form-group">
        <label><i class="fas fa-tv"></i> Serie</label>
        <select id="serieSelect" onchange="cargarTemporadas()">
          <option value="">Selecciona una serie</option>
        </select>
      </div>
      <div class="form-group">
        <label><i class="fas fa-layer-group"></i> Temporada</label>
        <select id="temporadaSelect" onchange="cargarIdiomas()" disabled>
          <option value="">Selecciona una temporada</option>
        </select>
      </div>
      <div class="form-group">
        <label><i class="fas fa-language"></i> Idioma</label>
        <select id="idiomaSelect" onchange="cargarServidores()" disabled>
          <option value="">Selecciona un idioma</option>
        </select>
      </div>
      <div class="form-group">
        <label><i class="fas fa-server"></i> Servidor</label>
        <select id="servidorSelect" onchange="cargarEpisodios()" disabled>
          <option value="">Selecciona un servidor</option>
        </select>
      </div>
    </div>

    <!-- Acciones finales -->
    <div class="acciones-finales">
       <!-- Botón para mostrar formulario de dimensiones -->
    <div class="btn-group" id="btnModificarGroup" style="display:none;">
      <button class="btn btn-warning" onclick="mostrarFormulario()">
        <i class="fas fa-arrows-alt"></i> Modificar dimensiones del video
      </button>
    </div>
      <button class="btn btn-success" onclick="guardarCambios()">
        <i class="fas fa-save"></i> Guardar cambios
      </button>
    </div>

    
    <!-- Formulario de dimensiones -->
    <div class="dimension-form" id="formDimension">
      <div class="form-row">
        <div class="field">
          <label><i class="fas fa-arrow-left"></i> Nuevo width</label>
          <input type="text" id="nuevoWidth" placeholder='Ej: 100%' />
        </div>
        <div class="field">
          <label><i class="fas fa-arrow-up"></i> Nuevo height</label>
          <input type="text" id="nuevoHeight" placeholder='Ej: 500' />
        </div>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" onclick="aplicarCambiosDimension()">
          <i class="fas fa-check"></i> Aplicar a todos
        </button>
        <button class="btn btn-outline" onclick="ocultarFormulario()">
          <i class="fas fa-times"></i> Cancelar
        </button>
      </div>
    </div>

    <!-- Tabla de episodios -->
    <div id="episodiosContainer"></div>

  </div>

  <script type="module" src="../../Config/config.js"></script>
<script defer src="../../Controllers/js_firebase/Redimensionar_IframesRegistrados_Controller.js"></script>
  
</body>
